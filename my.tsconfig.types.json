{
    "compilerOptions": {
        "allowJs": true,
        "checkJs": true,
        "resolveJsonModule": true,
        "emitDeclarationOnly": true,
        "stripInternal": true,
        "declaration": true,
        "outDir": "./dist/types-temp",
        "rootDir": ".",
        "moduleResolution": "NodeNext",
        "module": "NodeNext",
        "skipLibCheck": true,
        "types": []
    },
    "include": ["src/types.js", "src/**/*.js"],
    "exclude": ["node_modules/*", "tests/*"]
}
